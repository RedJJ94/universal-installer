    <string name="parental_guidance_card_title">অভিভাবকীয় নিয়ন্ত্রণ নির্দেশিকা</string>
    <string name="parental_guidance_card_subtitle">শিশুরা যাতে অ্যাপটি আনইনস্টল করতে বা নিরাপত্তা বাইপাস করতে না পারে</string>
